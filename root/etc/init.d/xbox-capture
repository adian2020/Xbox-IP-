#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/xbox-capture serve
	procd_set_param file /usr/bin/xbox-capture /usr/lib/xbox-capture/*.py
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	local services
	services="$(ubus call service list '{"name":"xbox-capture"}')" || exit $?
	# rc.common calls procd_kill after this hook. Skip deletion when already stopped.
	[ -n "$(jsonfilter -s "$services" -e '@["xbox-capture"]')" ] || exit 0
}

restart() {
	# An already stopped service exits the stop hook early, so isolate that exit.
	(trap '' TERM; stop "$@") || return $?
	start "$@"
}
